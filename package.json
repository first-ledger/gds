{
  "name": "@first-ledger/gds",
  "version": "1.0.0-b.6",
  "description": "This project is a comprehensive design system that integrates design tokens and typography for the First Ledger and First Ledger Mobile applications, facilitating a cohesive visual experience across platforms.",
  "keywords": [
    "design",
    "system",
    "figma",
    "tailwind",
    "tamagui",
    "typography",
    "tokens"
  ],
  "author": "First Ledger",
  "license": "MIT",
  "files": [
    "assets",
    "dist",
    "styles"
  ],
  "scripts": {
    "env": "dotenv",
    "env:prod": "dotenv -e production",
    "-----": "",
    "ts:test": "pnpm tsx --tsconfig ./config/tsconfig.test.json",
    "ts": "pnpm tsx --tsconfig ./config/tsconfig.build.json",
    "tsnode": "ts-node -P ./config/tsconfig.test.json",
    "-------------------------------": "",
    "script:flds:design": "node ./scripts/first-ledger/design.mjs",
    "script:flds:tw": "node ./scripts/first-ledger/tw.mjs",
    "script:flds": "pnpm script:flds:design && pnpm script:flds:tw",
    "-----------------------------------": "",
    "script:wds:tamagui": "pnpm ts ./scripts/wallet/tamagui.mts",
    "script:wds:design": "pnpm ts ./scripts/wallet/design.ts",
    "script:wds:design-old": "node ./scripts/wallet/design.mjs",
    "script:wds:design-tw": "node ./scripts/wallet/design-tw.mjs",
    "script:wds:tw-config": "node ./scripts/wallet/tw.mjs",
    "script:wds:tw": "node ./scripts/wallet/tw.mjs && node ./scripts/wallet/design-tw.mjs",
    "script:wds": "pnpm script:wds:design-old && pnpm script:wds:tw",
    "---------------------------------": "",
    "prebuild": "rm -rf ./dist && rm -rf ./build && rm -rf ./styles",
    "postbuild": "pnpm script:wds && pnpm script:flds && pnpm format:styles && zip -r .bundle.zip dist styles",
    "c": "node ./config/esbuild.config.js",
    "build:watch": "pnpm build && concurrently \"tsc -w\" \"tsc-alias -w\"",
    "rebuild": "pnpm run c && pnpm postbuild",
    "rebuild:watch": "pnpm rebuild && concurrently \"tsc -w\" \"tsc-alias -w\"",
    "----------------------------": "",
    "build": "pnpm prebuild && pnpm run c && pnpm postbuild",
    "build:tamagui": "pnpm prebuild && pnpm run c && pnpm script:tamagui",
    "style": "style-dictionary build --config ./config/styles.config.json",
    "dev": "pnpm rebuild:watch",
    "--------------------------------": "",
    "lint": "eslint src --report-unused-disable-directives",
    "format": "prettier 'src' --write --list-different",
    "format:styles": "prettier 'styles' --write --log-level silent",
    "format:check": "prettier 'src' --check",
    "----------------------------------": "",
    "test": "pnpm env -- jest --config ./config/jest.config.ts --all --coverage --forceExit",
    "testOne": "pnpm env -- jest --config ./config/jest.config.ts --coverage --forceExit",
    "----------------------": "",
    "prepub": "pnpm build",
    "pub": "pnpm prepub && pnpm publish",
    "pub:beta": "pnpm pub --tag beta",
    "pub:next": "pnpm pub--tag next",
    "pub:release": "pnpm publish --no-git-checks --access public",
    "-------------------": "",
    "release": "pnpm prepub && pnpm run env -- semantic-release --extends ./config/release.config.cjs",
    "test:release": "pnpm prepub && pnpm run env -- semantic-release --extends ./config/release.test.config.cjs"
  },
  "prettier": "./config/prettier.config.js",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tamagui/config": "^1.132.6",
    "@tamagui/theme-builder": "^1.132.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.13",
    "autoprefixer": "^10.4.21",
    "change-case": "^5.4.4",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.6",
    "fs-extra": "^11.3.0",
    "jest": "^30.0.4",
    "lodash": "^4.17.21",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4.1.11",
    "tamagui": "^1.132.6",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
