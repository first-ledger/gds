{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": "..",
    "outDir": "../dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/tokens/*": ["tokens/*"],
      "@/tests/*": ["tests/*"]
    }
  },
  "include": ["../src", "../static", "../static/**/*.json", "../tokens", "../tokens/**/*.json"]
}
